<?xml version="1.0" encoding="UTF-8"?>
<info xmlns:xsi="http://w3.org" xsi:noNamespaceSchemaLocation="https://nextcloud.com">
    <!-- O ID único do seu aplicativo no ecossistema -->
    <id>universal_media_tracker</id>
    
    <!-- Nome visível na loja e no menu superior do Nextcloud -->
    <name>Universal Media Tracker</name>
    
    <!-- Descrição curta do projeto -->
    <summary>Rastreador universal de filmes, séries e animes no estilo MyAnimeList integrado ao TMDB.</summary>
    
    <description>Acompanhe seu progresso de mídias, gerencie episódios assistidos, datas de início/término e consulte estatísticas detalhadas com barras de progresso proporcionais, tudo em português.</description>
    
    <version>1.0.0</version>
    <licence>agpl</licence>
    <author>Seu Nome</author>
    <namespace>UniversalMediaTracker</namespace>

    <category>social</category>
    <category>tools</category>

    <bugs>https://github.com</bugs>

    <!-- Versões do Nextcloud que seu aplicativo suporta -->
    <dependencies>
        <nextcloud min-version="28" max-version="31"/>
    </dependencies>

    <!-- Configuração exclusiva para ExApps que aponta para o seu servidor Node -->
    <external-app>
        <docker-image></docker-image>
        <supported-platforms/>
    </external-app>
</info>
